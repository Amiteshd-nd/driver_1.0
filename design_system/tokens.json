{
  "$schema": "./tokens.schema.json",
  "name": "Flying Cobra Design System",
  "version": "0.1.0",
  "description": "Single source of truth. `node build-tokens.mjs` emits tokens.css (web) and tokens.dart (Flutter). Components read only from these tokens; a new rarity, tier or finish is a new token entry, never a new component.",

  "color": {
    "light": {
      "bg": "#F7F3EC", "surface": "#FFFFFF", "surfaceAlt": "#EFE9DE",
      "ink": "#1B1B18", "inkMuted": "#6B6A63", "line": "#E2DCD0",
      "accent": "#C8551B", "accentInk": "#FFFFFF",
      "success": "#2E7D5B", "warn": "#B3791C", "danger": "#A33A2B",
      "scrim": "rgba(12,12,11,0.93)"
    },
    "dark": {
      "bg": "#121311", "surface": "#1C1E1B", "surfaceAlt": "#262925",
      "ink": "#F2EFE8", "inkMuted": "#A5A49C", "line": "#33362F",
      "accent": "#F08A4B", "accentInk": "#1B1B18",
      "success": "#59B98F", "warn": "#E0A94C", "danger": "#E0695A",
      "scrim": "rgba(0,0,0,0.94)"
    }
  },

  "family": {
    "swift":     { "bg": "#F5E2C8", "fg": "#5A2E0C", "accent": "#E0902F", "label": "Swift",     "mood": "warm amber, sand" },
    "steady":    { "bg": "#D9E7D6", "fg": "#1F3D2B", "accent": "#4F8A5B", "label": "Steady",    "mood": "forest" },
    "calm":      { "bg": "#E6DFF0", "fg": "#3A2E57", "accent": "#8B74C9", "label": "Calm",      "mood": "dusk lavender" },
    "gentle":    { "bg": "#F1DCD1", "fg": "#5B2F22", "accent": "#C76A4E", "label": "Gentle",    "mood": "terracotta" },
    "time":      { "bg": "#1F2340", "fg": "#E7E4FF", "accent": "#8FA3FF", "label": "Time of day", "mood": "indigo night" },
    "explorer":  { "bg": "#F3E3B8", "fg": "#4E3B10", "accent": "#D1A233", "label": "Explorer",  "mood": "ochre" },
    "regional":  { "bg": "#D3ECEA", "fg": "#134845", "accent": "#2E9C96", "label": "Regional",  "mood": "teal" },
    "weekly":    { "bg": "#F0D4D8", "fg": "#5A1322", "accent": "#B82A47", "label": "Weekly",    "mood": "crimson" },
    "migratory": { "bg": "#D7E8F7", "fg": "#143A5C", "accent": "#3E86C8", "label": "Migratory", "mood": "sky" },
    "secret":    { "bg": "#E7DAF5", "fg": "#3C1F5E", "accent": "#9D6AE3", "label": "Secret",    "mood": "iridescent violet" },
    "national":  { "bg": "#FBE4C6", "fg": "#6B3A0E", "accent": "#F2A33A", "label": "National",  "mood": "saffron" }
  },

  "rarity": {
    "common":    { "label": "Common",    "borderWidth": 1,   "borderStyle": "hairline", "foil": false, "particles": 0,  "revealMs": 600, "haptic": "medium",  "drawWeight": 60 },
    "uncommon":  { "label": "Uncommon",  "borderWidth": 1.5, "borderStyle": "accent",   "foil": false, "particles": 0,  "revealMs": 600, "haptic": "medium",  "drawWeight": 25 },
    "rare":      { "label": "Rare",      "borderWidth": 2,   "borderStyle": "gradient", "foil": false, "particles": 0,  "revealMs": 700, "haptic": "success", "drawWeight": 10 },
    "epic":      { "label": "Epic",      "borderWidth": 2.5, "borderStyle": "gradient", "foil": true,  "particles": 0,  "revealMs": 800, "haptic": "success", "drawWeight": 4 },
    "legendary": { "label": "Legendary", "borderWidth": 3,   "borderStyle": "animated", "foil": true,  "particles": 24, "revealMs": 900, "haptic": "success", "drawWeight": 1 }
  },

  "tier": {
    "baby":  { "label": "Baby",  "artScale": 0.70, "initialScale": 18, "minKm": 0 },
    "young": { "label": "Young", "artScale": 0.80, "initialScale": 23, "minKm": 3 },
    "adult": { "label": "Adult", "artScale": 0.92, "initialScale": 27, "minKm": 7 }
  },

  "finish": {
    "plain":   { "label": "Plain",   "glowBlur": 0,  "glowAlpha": 0,    "breathe": false, "minRunDays": 0 },
    "glow":    { "label": "Glow",    "glowBlur": 12, "glowAlpha": 0.35, "breathe": false, "minRunDays": 4 },
    "radiant": { "label": "Radiant", "glowBlur": 24, "glowAlpha": 0.55, "breathe": true,  "minRunDays": 7 }
  },

  "typography": {
    "display": { "family": "Fraunces", "fallback": "ui-serif, Georgia, serif" },
    "text":    { "family": "Manrope",  "fallback": "ui-sans-serif, system-ui, sans-serif" },
    "scale": {
      "displayLarge":  { "font": "display", "size": 40, "line": 46, "weight": 600 },
      "displayMedium": { "font": "display", "size": 32, "line": 38, "weight": 600 },
      "displaySmall":  { "font": "display", "size": 28, "line": 32, "weight": 600, "use": "card animal name" },
      "headlineMedium":{ "font": "display", "size": 24, "line": 30, "weight": 600, "use": "screen title" },
      "headlineSmall": { "font": "display", "size": 20, "line": 26, "weight": 600 },
      "titleLarge":    { "font": "display", "size": 22, "line": 26, "weight": 500, "use": "stat numerals, tabular" },
      "serial":        { "font": "display", "size": 18, "line": 22, "weight": 500, "tracking": 0.08, "tabular": true, "use": "banknote-style serial" },
      "titleMedium":   { "font": "text", "size": 16, "line": 22, "weight": 600 },
      "titleSmall":    { "font": "text", "size": 14, "line": 20, "weight": 600 },
      "bodyLarge":     { "font": "text", "size": 18, "line": 26, "weight": 400 },
      "bodyMedium":    { "font": "text", "size": 16, "line": 24, "weight": 400 },
      "bodySmall":     { "font": "text", "size": 14, "line": 20, "weight": 400 },
      "flavour":       { "font": "text", "size": 14, "line": 20, "weight": 400, "italic": true, "use": "card flavour line" },
      "labelLarge":    { "font": "text", "size": 16, "line": 20, "weight": 600 },
      "labelMedium":   { "font": "text", "size": 13, "line": 18, "weight": 500, "tracking": 0.02 },
      "labelSmall":    { "font": "text", "size": 11, "line": 14, "weight": 500, "tracking": 0.04 }
    }
  },

  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "card": 16, "sheet": 24, "control": 12, "chip": 999, "art": 10 },
  "elevation": {
    "none": "none",
    "sm":   "0 1px 2px rgba(27,27,24,0.06)",
    "card": "0 10px 26px rgba(27,27,24,0.12), 0 2px 6px rgba(27,27,24,0.06)",
    "sheet":"0 -8px 30px rgba(27,27,24,0.14)",
    "cardDark": "0 12px 30px rgba(0,0,0,0.5)"
  },

  "motion": {
    "duration": {
      "instant": 100, "quick": 200, "standard": 300, "emphasised": 420,
      "reveal": 600, "celebrate": 900, "breathe": 4000, "foil": 5500, "legendarySpin": 6000
    },
    "easing": {
      "standard":   "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "emphasised": "cubic-bezier(0.22, 0.9, 0.3, 1)",
      "spring":     "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "reducedMotion": "Replace translate/flip with crossfade at `quick`; disable particles, foil tilt and breathing; keep haptics and text."
  },

  "haptic": {
    "light":   { "use": "card slides in, chip toggles" },
    "medium":  { "use": "card flip, confirm actions" },
    "heavy":   { "use": "rare+ reveal moment" },
    "success": { "use": "growth, mastery, weekly card" },
    "warning": { "use": "GPS lost, offline save" }
  },

  "layout": {
    "cardAspect": "5 / 7",
    "cardWidthDefault": 300,
    "cardWidthTile": 150,
    "cardArtMinShare": 0.5,
    "touchTargetMin": 48,
    "posterSize": [1080, 1920]
  },

  "icon": {
    "set": "Material Symbols Rounded (app) · inline SVG paw mark (brand)",
    "sizes": { "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "mark": "four-toed paw print, pad = rounded trapezoid, radius 16"
  }
}
